{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Profile",
  "type": "object",
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "allow_all": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "allow_env": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "allow_host_net": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "allow_net": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "allow_read": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "allow_write": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "debug": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deny_env": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "deny_net": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "deny_read": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "deny_read_globs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "deny_write": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "deny_write_exceptions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/WriteException"
      }
    },
    "deny_write_globs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "docker": {
      "anyOf": [
        {
          "$ref": "#/definitions/DockerAccessPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "no_sandbox": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "restore": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "secret_hosts": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "set_env": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "snapshot": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "snapshot_exclude": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "snapshot_paths": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "strict_sandbox": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "use": {
      "description": "Profile(s) to compose from.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "DockerAccessPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "disabled"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "endpoint",
            "mode",
            "targets"
          ],
          "properties": {
            "endpoint": {
              "$ref": "#/definitions/UnixSocketPath"
            },
            "engineInfo": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "targeted"
              ]
            },
            "targets": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/DockerTargetGrant"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "endpoint",
            "mode"
          ],
          "properties": {
            "endpoint": {
              "$ref": "#/definitions/UnixSocketPath"
            },
            "mode": {
              "type": "string",
              "enum": [
                "full"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "DockerOperation": {
      "type": "string",
      "enum": [
        "ps",
        "inspect",
        "logs",
        "stats",
        "exec",
        "start",
        "stop",
        "restart"
      ]
    },
    "DockerTargetGrant": {
      "type": "object",
      "required": [
        "selector"
      ],
      "properties": {
        "allowUnsafeExec": {
          "description": "Explicit permanent exception. Absence retains bounded inspection.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "allowUnsafeTarget": {
          "default": false,
          "type": "boolean"
        },
        "operations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/DockerOperation"
          }
        },
        "selector": {
          "$ref": "#/definitions/DockerTargetSelector"
        }
      },
      "additionalProperties": false
    },
    "DockerTargetSelector": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "name",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "container-name"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "project",
            "service",
            "type"
          ],
          "properties": {
            "project": {
              "type": "string"
            },
            "service": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "compose-service"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Runtime-only, exact-container authorization. Callers must reject this selector in persistent authority so it cannot outlive its owning session.",
          "type": "object",
          "required": [
            "id",
            "type",
            "unsafeExecExpiresAtMs"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "ephemeral-container"
              ]
            },
            "unsafeExecExpiresAtMs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "UnixSocketPath": {
      "description": "A local Unix-domain socket endpoint for the Docker Engine API.",
      "type": "string"
    },
    "WriteException": {
      "type": "object",
      "required": [
        "paths",
        "pattern"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pattern": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
