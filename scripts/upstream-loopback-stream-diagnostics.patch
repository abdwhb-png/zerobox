+#[cfg(test)]
+mod loopback_stream_tests {
+    use super::*;
+
+    fn connected_streams() -> (TcpStream, TcpStream, UnixStream, UnixStream) {
+        let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+        let client = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (tcp, _) = listener.accept().unwrap();
+        let (unix, proxy) = UnixStream::pair().unwrap();
+        client
+            .set_read_timeout(Some(Duration::from_secs(2)))
+            .unwrap();
+        proxy
+            .set_read_timeout(Some(Duration::from_secs(2)))
+            .unwrap();
+        (client, tcp, unix, proxy)
+    }
+
+    #[test]
+    fn local_client_abort_is_cancellation_and_releases_the_proxy_stream() {
+        let (mut client, tcp, unix, mut proxy) = connected_streams();
+        let relay = std::thread::spawn(move || proxy_loopback_stream(tcp, unix));
+        proxy.write_all(b"response").unwrap();
+        let mut response = [0; 8];
+        client.read_exact(&mut response).unwrap();
+        assert_eq!(&response, b"response");
+        let linger = libc::linger {
+            l_onoff: 1,
+            l_linger: 0,
+        };
+        let result = unsafe {
+            libc::setsockopt(
+                client.as_raw_fd(),
+                libc::SOL_SOCKET,
+                libc::SO_LINGER,
+                std::ptr::from_ref(&linger).cast(),
+                std::mem::size_of_val(&linger) as libc::socklen_t,
+            )
+        };
+        assert_eq!(result, 0);
+        drop(client);
+        assert_eq!(
+            relay.join().unwrap().unwrap(),
+            LoopbackStreamEnd::ClientDisconnected
+        );
+        assert_eq!(proxy.read(&mut [0]).unwrap(), 0);
+    }
+
+    #[test]
+    fn proxy_reset_is_not_reclassified_as_client_cancellation() {
+        let (mut client, tcp, unix, proxy) = connected_streams();
+        let relay = std::thread::spawn(move || proxy_loopback_stream(tcp, unix));
+        client.write_all(b"unread request").unwrap();
+        let deadline = std::time::Instant::now() + Duration::from_secs(2);
+        loop {
+            let mut queued: libc::c_int = 0;
+            assert_eq!(
+                unsafe { libc::ioctl(proxy.as_raw_fd(), libc::FIONREAD, &mut queued) },
+                0
+            );
+            if queued > 0 {
+                break;
+            }
+            assert!(
+                std::time::Instant::now() < deadline,
+                "request did not reach proxy"
+            );
+            std::thread::yield_now();
+        }
+        // Closing an AF_UNIX stream with unread data resets its peer.
+        drop(proxy);
+        let error = relay
+            .join()
+            .unwrap()
+            .expect_err("upstream reset must remain an error");
+        assert_eq!(error.kind(), io::ErrorKind::ConnectionReset);
+        let cause = error
+            .get_ref()
+            .unwrap()
+            .downcast_ref::<BridgeIoFailure>()
+            .unwrap();
+        assert_eq!(cause.side, BridgeSide::Right);
+        assert_eq!(cause.operation, BridgeOperation::Read);
+    }
+
+    #[test]
+    fn idle_timeout_retains_its_origin_and_wakes_the_other_direction() {
+        let (left, _client) = UnixStream::pair().unwrap();
+        let (right, _proxy) = UnixStream::pair().unwrap();
+        left.set_read_timeout(Some(Duration::from_millis(30)))
+            .unwrap();
+        let left_reader = left.try_clone().unwrap();
+        let right_writer = right.try_clone().unwrap();
+        let error = proxy_bidirectional(left, right, left_reader, right_writer).unwrap_err();
+        assert!(matches!(
+            error.kind(),
+            io::ErrorKind::WouldBlock | io::ErrorKind::TimedOut
+        ));
+        let cause = error
+            .get_ref()
+            .unwrap()
+            .downcast_ref::<BridgeIoFailure>()
+            .unwrap();
+        assert_eq!(cause.side, BridgeSide::Left);
+        assert_eq!(cause.operation, BridgeOperation::Read);
+    }
+}
