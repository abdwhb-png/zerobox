+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum BridgeSide {
+    Left,
+    Right,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum BridgeOperation {
+    Read,
+    Write,
+    Shutdown,
+}
+
+#[derive(Debug)]
+struct BridgeIoFailure {
+    side: BridgeSide,
+    operation: BridgeOperation,
+    source: io::Error,
+}
+
+impl std::fmt::Display for BridgeIoFailure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        self.source.fmt(f)
+    }
+}
+
+impl std::error::Error for BridgeIoFailure {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        Some(&self.source)
+    }
+}
+
+fn bridge_io_error(side: BridgeSide, operation: BridgeOperation, source: io::Error) -> io::Error {
+    io::Error::new(
+        source.kind(),
+        BridgeIoFailure {
+            side,
+            operation,
+            source,
+        },
+    )
+}
+
+struct BridgeIo<T> {
+    stream: T,
+    side: BridgeSide,
+}
+
+impl<T: Read> Read for BridgeIo<T> {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        self.stream
+            .read(buffer)
+            .map_err(|error| bridge_io_error(self.side, BridgeOperation::Read, error))
+    }
+}
+
+impl<T: Write> Write for BridgeIo<T> {
+    fn write(&mut self, buffer: &[u8]) -> io::Result<usize> {
+        self.stream
+            .write(buffer)
+            .map_err(|error| bridge_io_error(self.side, BridgeOperation::Write, error))
+    }
+
+    fn flush(&mut self) -> io::Result<()> {
+        self.stream
+            .flush()
+            .map_err(|error| bridge_io_error(self.side, BridgeOperation::Write, error))
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum LoopbackStreamEnd {
+    Closed,
+    ClientDisconnected,
+}
+
+fn proxy_loopback_stream(tcp: TcpStream, unix: UnixStream) -> io::Result<LoopbackStreamEnd> {
+    match proxy_tcp_unix(tcp, unix) {
+        Ok(()) => Ok(LoopbackStreamEnd::Closed),
+        Err(error) => {
+            let client_closed = error
+                .get_ref()
+                .and_then(|cause| cause.downcast_ref::<BridgeIoFailure>())
+                .is_some_and(|cause| {
+                    cause.side == BridgeSide::Left
+                        && matches!(
+                            cause.operation,
+                            BridgeOperation::Read | BridgeOperation::Write
+                        )
+                        && matches!(
+                            cause.source.kind(),
+                            io::ErrorKind::ConnectionReset | io::ErrorKind::BrokenPipe
+                        )
+                });
+            if client_closed {
+                // The local caller disconnected. Some clients intentionally use
+                // abortive TCP close even after a complete application exchange.
+                // This is a cancellation, not a verdict on command success. Keep
+                // proxy-side errors and timeouts as errors, with their origin.
+                Ok(LoopbackStreamEnd::ClientDisconnected)
+            } else {
+                Err(error)
+            }
+        }
+    }
+}
