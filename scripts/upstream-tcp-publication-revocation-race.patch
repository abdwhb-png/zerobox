+#[cfg(test)]
+mod tcp_publication_control_tests {
+    use super::{TCP_PUBLICATION_REVOKED, read_publication_status};
+    use std::io::Write;
+    use std::net::Shutdown;
+    use std::os::unix::net::UnixStream;
+
+    #[test]
+    fn revocation_frame_is_accepted_while_waiting_for_a_publication_status() {
+        let (mut writer, mut reader) = UnixStream::pair().expect("create publication control pair");
+        writer
+            .write_all(&[TCP_PUBLICATION_REVOKED])
+            .expect("send revocation frame");
+        writer
+            .shutdown(Shutdown::Write)
+            .expect("finish revocation frame");
+
+        assert_eq!(
+            read_publication_status(&mut reader).expect("parse revocation frame"),
+            (TCP_PUBLICATION_REVOKED, 0, 0)
+        );
+    }
+}
