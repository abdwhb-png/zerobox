+
+fn drain_revoked_tcp_publications(
+    control: &mut UnixStream,
+    active: &AtomicUsize,
+    relays: &TcpPublicationRelays,
+    revoking: &std::sync::atomic::AtomicBool,
+) -> io::Result<()> {
+    revoking.store(true, Ordering::Release);
+    control.shutdown(Shutdown::Both)?;
+    let deadline = std::time::Instant::now() + TCP_PUBLICATION_DRAIN_TIMEOUT;
+    while active.load(Ordering::Acquire) != 0 && std::time::Instant::now() < deadline {
+        std::thread::sleep(Duration::from_millis(25));
+    }
+    if active.load(Ordering::Acquire) != 0 {
+        relays.shutdown_all();
+        let forced_deadline = std::time::Instant::now() + Duration::from_millis(250);
+        while active.load(Ordering::Acquire) != 0 && std::time::Instant::now() < forced_deadline {
+            std::thread::sleep(Duration::from_millis(10));
         }
     }
+    Ok(())
 }
 
