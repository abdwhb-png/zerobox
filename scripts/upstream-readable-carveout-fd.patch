+    #[test]
+    fn split_policy_readable_symlinks_bind_the_pinned_target() {
+        for kind in ["relative", "absolute", "directory", "ancestor"] {
+            let fixture = TempDir::new().expect("fixture");
+            let resource = fixture.path().join("resource");
+            let alias = fixture.path().join("alias");
+            std::fs::create_dir(&resource).expect("resource directory");
+            std::fs::write(resource.join("visible"), "visible").expect("resource file");
+            let directory = matches!(kind, "directory" | "ancestor");
+            let target = if directory {
+                PathBuf::from("resource")
+            } else if kind == "absolute" {
+                resource.join("visible")
+            } else {
+                PathBuf::from("resource/visible")
+            };
+            std::os::unix::fs::symlink(target, &alias).expect("alias");
+            let grant = if kind == "ancestor" {
+                alias.join("visible")
+            } else {
+                alias
+            };
+            let expected = if kind == "directory" {
+                resource
+            } else {
+                resource.join("visible")
+            };
+            let expected = expected.canonicalize().expect("canonical fixture target");
+            let policy = FileSystemSandboxPolicy::restricted(vec![
+                FileSystemSandboxEntry {
+                    path: FileSystemPath::Special {
+                        value: FileSystemSpecialPath::Root,
+                    },
+                    access: FileSystemAccessMode::None,
+                },
+                FileSystemSandboxEntry {
+                    path: FileSystemPath::Path {
+                        path: AbsolutePathBuf::from_absolute_path(grant).expect("grant"),
+                    },
+                    access: FileSystemAccessMode::Read,
+                },
+            ]);
+            let args =
+                create_filesystem_args(&policy, fixture.path(), NO_UNREADABLE_GLOB_SCAN_MAX_DEPTH)
+                    .expect("filesystem args");
+            let mount = args
+                .args
+                .windows(3)
+                .find(|args| args[0] == "--ro-bind-fd" && args[2] == path_to_string(&expected))
+                .expect("bind destination must be the pinned target, never a symlink");
+            let source = args
+                .preserved_files
+                .iter()
+                .find(|file| file.as_raw_fd().to_string() == mount[1])
+                .expect("preserved source FD");
+            assert_eq!(
+                source.metadata().expect("pinned metadata").ino(),
+                std::fs::metadata(expected).expect("target metadata").ino()
+            );
+        }
     }
 
