 #[test]
+fn exec_error_reader_retries_interrupted_and_assembles_exact_frame() {
+    let expected = libc::ENOENT.to_ne_bytes();
+    let mut call = 0;
+    let result = read_exec_error_with(|buffer| {
+        call += 1;
+        match call {
+            1 => Err(std::io::Error::from(std::io::ErrorKind::Interrupted)),
+            2 => {
+                buffer[..2].copy_from_slice(&expected[..2]);
+                Ok(2)
+            }
+            3 => {
+                buffer[..2].copy_from_slice(&expected[2..]);
+                Ok(2)
+            }
+            _ => Ok(0),
+        }
+    })
+    .expect("read exact exec error frame");
+
+    assert_eq!(result, Some(libc::ENOENT));
+}
+
+#[test]
+fn setup_writer_retries_interrupted_and_completes_partial_writes() {
+    let mut call = 0;
+    let mut written = Vec::new();
+    write_all_with(b"STARTED\n", |remaining| {
+        call += 1;
+        if call == 1 {
+            return Err(std::io::Error::from(std::io::ErrorKind::Interrupted));
+        }
+        let count = remaining.len().min(2);
+        written.extend_from_slice(&remaining[..count]);
+        Ok(count)
+    })
+    .expect("write complete setup frame");
+
+    assert_eq!(written, b"STARTED\n");
+}
