+fn display_authority(host: &str, port: u16) -> String {
+    let host = host.escape_default().to_string();
+    if host.contains(':') {
+        format!("[{host}]:{port}")
+    } else {
+        format!("{host}:{port}")
+    }
+}
+
+fn write_denial_diagnostic(message: &str) {
+    use std::io::Write as _;
+
+    if let Err(error) = writeln!(std::io::stderr().lock(), "zerobox: {message}") {
+        error!("failed to write network denial diagnostic: {error}");
+    }
+}
+
