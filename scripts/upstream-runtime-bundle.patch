+struct RuntimeAdmission {
+    control: UnixStream,
+    token: String,
+    receipt: String,
+}
+
+fn observed_kernel_mounts() -> std::io::Result<Vec<serde_json::Value>> {
+    let table = fs::read_to_string("/proc/self/mountinfo")?;
+    let decode = |value: &str| value.replace("\\040", " ").replace("\\011", "\t")
+        .replace("\\012", "\n").replace("\\134", "\\");
+    let mut mounts = Vec::new();
+    for line in table.lines() {
+        let fields = line.split_whitespace().collect::<Vec<_>>();
+        let separator = fields.iter().position(|field| *field == "-")
+            .filter(|index| *index >= 6 && fields.len() > *index + 2)
+            .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidData, "invalid kernel mount table"))?;
+        mounts.push(serde_json::json!({
+            "destination": decode(fields[4]),
+            "root": decode(fields[3]),
+            "source": decode(fields[separator + 2]),
+            "filesystem": fields[separator + 1],
+            "access": if fields[5].split(',').any(|flag| flag == "ro") { "ro" } else { "rw" },
+        }));
+    }
+    Ok(mounts)
+}
+
+fn begin_runtime_admission(
+    environment: &HashMap<String, String>,
+) -> std::io::Result<RuntimeAdmission> {
+    const MAX_ADMISSION_BYTES: usize = 1024 * 1024;
+    let receipt = environment
+        .get(RUNTIME_ADMISSION_RECEIPT_ENV)
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "runtime admission receipt is unavailable",
+            )
+        })?;
+    if receipt.is_empty() || receipt.len() > MAX_ADMISSION_BYTES {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "runtime admission receipt exceeds its size limit",
+        ));
+    }
+    let mut observed: serde_json::Value = serde_json::from_str(receipt)
+        .map_err(|error| std::io::Error::new(std::io::ErrorKind::InvalidData, error))?;
+    let mounts = observed_kernel_mounts()?;
+    for destination in ["/__zerobox", "/__zerobox/runtime"] {
+        if !mounts.iter().any(|mount|
+            mount["destination"] == destination && mount["access"] == "ro") {
+            return Err(std::io::Error::new(std::io::ErrorKind::PermissionDenied,
+                format!("private runtime mount is absent or writable: {destination}")));
+        }
+    }
+    if observed["runtime"]["component"] == "analysis" && !mounts.iter().any(|mount|
+        mount["destination"] == "/__zerobox/analysis" && mount["access"] == "ro") {
+        return Err(std::io::Error::new(std::io::ErrorKind::PermissionDenied, "private Analysis mount is absent or writable"));
+    }
+    observed["kernelMounts"] = serde_json::Value::Array(mounts);
+    let receipt = serde_json::to_string(&observed)
+        .map_err(|error| std::io::Error::new(std::io::ErrorKind::InvalidData, error))?;
+    if receipt.len() > MAX_ADMISSION_BYTES {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidData, "runtime admission receipt exceeds its size limit"));
+    }
+    let token = environment
+        .get(RUNTIME_ADMISSION_TOKEN_ENV)
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "runtime admission token is unavailable",
+            )
+        })?;
+    Ok(RuntimeAdmission {
+        control: UnixStream::connect(RUNTIME_ADMISSION_SOCKET)?,
+        token: token.clone(),
+        receipt,
+    })
+}
+
+fn finish_runtime_admission(admission: RuntimeAdmission) -> std::io::Result<()> {
+    use std::os::fd::AsRawFd;
+
+    let control_fd = admission.control.as_raw_fd();
+    write_all_control(control_fd, admission.token.as_bytes())?;
+    write_all_control(control_fd, &(admission.receipt.len() as u32).to_be_bytes())?;
+    write_all_control(control_fd, admission.receipt.as_bytes())?;
+    let mut acknowledgement = [0_u8; 4];
+    read_exact_control(control_fd, &mut acknowledgement)?;
+    if acknowledgement != *b"ACK\n" {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "runtime admission was not acknowledged by the supervisor",
+        ));
+    }
+    Ok(())
+}
+
+fn write_all_control(fd: i32, bytes: &[u8]) -> std::io::Result<()> {
+    let mut offset = 0;
+    while offset < bytes.len() {
+        let written = unsafe {
+            libc::write(
+                fd,
+                bytes[offset..].as_ptr().cast::<libc::c_void>(),
+                bytes.len() - offset,
+            )
+        };
+        if written > 0 {
+            offset += written as usize;
+        } else if written == 0 {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::WriteZero,
+                "runtime admission control closed",
+            ));
+        } else {
+            let error = std::io::Error::last_os_error();
+            if error.kind() != std::io::ErrorKind::Interrupted {
+                return Err(error);
+            }
+        }
+    }
+    Ok(())
+}
+
+fn read_exact_control(fd: i32, bytes: &mut [u8]) -> std::io::Result<()> {
+    let mut offset = 0;
+    while offset < bytes.len() {
+        let read = unsafe {
+            libc::read(
+                fd,
+                bytes[offset..].as_mut_ptr().cast::<libc::c_void>(),
+                bytes.len() - offset,
+            )
+        };
+        if read > 0 {
+            offset += read as usize;
+        } else if read == 0 {
+            return Err(std::io::Error::new(
