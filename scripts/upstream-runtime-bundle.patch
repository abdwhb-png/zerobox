+fn runtime_policy_mount_resolves_an_exact_file_alias() {
+    let root = tempfile::tempdir().unwrap();
+    let source = root.path().join("tool-v1");
+    std::fs::write(&source, b"authorized").unwrap();
+    let aliases = vec![RuntimePathAlias { destination: PathBuf::from("/alias-tool"), target: source, directory: false }];
+    let mut args = crate::bwrap::BwrapArgs {
+        args: ["bwrap", "--ro-bind", "/alias-tool", "/alias-tool", "--", "true"].into_iter().map(str::to_owned).collect(),
+        preserved_files: Vec::new(), synthetic_mount_targets: Vec::new(),
+        protected_create_targets: Vec::new(), used_tmpfs_root: true,
+    };
+    pin_runtime_policy_mounts(&mut args, &aliases).unwrap();
+    assert_eq!(std::fs::read(format!("/proc/self/fd/{}", args.preserved_files[0].as_raw_fd())).unwrap(), b"authorized");
+}
