+#[test]
+fn runtime_policy_mount_keeps_its_validated_source_after_replacement() {
+    let root = tempfile::tempdir().unwrap();
+    let source = root.path().join("tool");
+    let previous = root.path().join("previous");
+    std::fs::write(&source, b"authorized").unwrap();
+    let mut args = crate::bwrap::BwrapArgs {
+        args: vec!["bwrap".into(), "--ro-bind".into(), source.to_string_lossy().into(), "/tools/tool".into(), "--".into(), "true".into()],
+        preserved_files: Vec::new(), synthetic_mount_targets: Vec::new(),
+        protected_create_targets: Vec::new(), used_tmpfs_root: true,
+    };
+    pin_runtime_policy_mounts(&mut args, &[]).unwrap();
+    std::fs::rename(&source, &previous).unwrap();
+    std::fs::write(&source, b"replacement").unwrap();
+    assert_eq!(args.args[1], "--ro-bind-fd");
+    assert_eq!(args.args[3], "/tools/tool");
+    assert_eq!(std::fs::read(format!("/proc/self/fd/{}", args.preserved_files[0].as_raw_fd())).unwrap(), b"authorized");
+}
