+#[derive(Clone, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RuntimePathAlias {
+    destination: PathBuf,
+    target: PathBuf,
+    directory: bool,
+}
+
+fn inject_runtime_path_aliases(
+    args: &mut Vec<String>,
+    aliases: Vec<RuntimePathAlias>,
+) -> std::io::Result<()> {
+    if aliases.is_empty() {
+        return Ok(());
+    }
+    let root = args
+        .windows(2)
+        .position(|pair| pair == ["--tmpfs", "/"])
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "runtime aliases require a private filesystem root",
+            )
+        })?;
+    let mut additions = Vec::new();
+    for alias in &aliases {
+        if !alias.destination.is_absolute()
+            || !alias.target.is_absolute()
+            || alias.destination == Path::new("/")
+            || alias.destination.starts_with("/__zerobox")
+            || alias
+                .destination
+                .components()
+                .chain(alias.target.components())
+                .any(|part| matches!(part, std::path::Component::ParentDir))
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "runtime alias paths must be absolute and outside the reserved prefix",
+            ));
+        }
+        if let Some(parent) = alias
+            .destination
+            .parent()
+            .filter(|parent| *parent != Path::new("/"))
+        {
+            additions.extend(["--dir".to_string(), parent.to_string_lossy().into_owned()]);
+        }
+        let target_directory = if alias.directory {
+            Some(alias.target.as_path())
+        } else {
+            alias.target.parent()
+        };
+        if let Some(directory) = target_directory.filter(|path| *path != Path::new("/")) {
+            additions.extend(["--dir".to_string(), directory.to_string_lossy().into_owned()]);
+        }
+        let parent = alias.destination.parent().ok_or_else(||
+            std::io::Error::new(std::io::ErrorKind::InvalidInput, "runtime alias has no parent"))?;
+        let filename = alias.destination.file_name().ok_or_else(||
+            std::io::Error::new(std::io::ErrorKind::InvalidInput, "runtime alias has no filename"))?;
+        additions.extend([
+            "--symlink".to_string(),
+            relative_runtime_alias_target(
+                &resolve_runtime_alias_path(parent, &aliases).join(filename),
+                &alias.target,
+            )?,
+            alias.destination.to_string_lossy().into_owned(),
+        ]);
+    }
+    // Create links on the empty private root before any host bind can cover a
+    // destination. Links reference only resources already granted by policy.
+    args.splice(root + 2..root + 2, additions);
+    Ok(())
+}
+
+// Resolve against the canonical aliases captured by the policy owner, never
+// against a host symlink that could have changed since authorization.
+fn resolve_runtime_alias_path(path: &Path, aliases: &[RuntimePathAlias]) -> PathBuf {
+    aliases.iter()
+        .filter_map(|alias| path.strip_prefix(&alias.destination).ok().map(|suffix| (alias, suffix)))
+        .max_by_key(|(alias, _)| alias.destination.components().count())
+        .map(|(alias, suffix)| {
+            if suffix.as_os_str().is_empty() { alias.target.clone() } else { alias.target.join(suffix) }
+        })
+        .unwrap_or_else(|| path.to_path_buf())
+}
+
+fn open_canonical_mount_source(expected: &Path) -> std::io::Result<File> {
+    let source = OpenOptions::new().read(true)
+        .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_PATH)
+        .open(expected)?;
+    let actual = std::fs::read_link(format!("/proc/self/fd/{}", source.as_raw_fd()))?;
+    if actual != expected || source.metadata()?.file_type().is_symlink() {
+        return Err(std::io::Error::new(std::io::ErrorKind::PermissionDenied,
+            format!("canonical mount source changed before admission: {}", expected.display())));
+    }
+    Ok(source)
+}
+
+fn pin_runtime_policy_mounts(
+    args: &mut crate::bwrap::BwrapArgs,
+    aliases: &[RuntimePathAlias],
+) -> std::io::Result<()> {
+    let mut index = 0;
+    while index < args.args.len() && args.args[index] != "--" {
+        if matches!(args.args[index].as_str(), "--ro-bind" | "--bind") {
+            let source = args.args.get(index + 1).ok_or_else(||
+                std::io::Error::new(std::io::ErrorKind::InvalidInput, "missing policy mount source"))?;
+            let expected = resolve_runtime_alias_path(Path::new(source), aliases);
+            let file = open_canonical_mount_source(&expected)?;
+            args.args[index].push_str("-fd");
+            args.args[index + 1] = file.as_raw_fd().to_string();
+            args.preserved_files.push(file);
+            index += 3;
+        } else {
+            index += 1;
+        }
+    }
+    Ok(())
+}
+
+// Bubblewrap creates mountpoints before pivoting into the private root.
+// Relative links resolve inside that root during both construction and use.
+fn relative_runtime_alias_target(destination: &Path, target: &Path) -> std::io::Result<String> {
+    let parent = destination.parent().ok_or_else(||
+        std::io::Error::new(std::io::ErrorKind::InvalidInput, "runtime alias has no parent"))?;
+    let from = parent.components().collect::<Vec<_>>();
+    let to = target.components().collect::<Vec<_>>();
+    let shared = from.iter().zip(&to).take_while(|(a, b)| a == b).count();
+    let mut result = PathBuf::new();
+    for _ in &from[shared..] { result.push(".."); }
+    for part in &to[shared..] { result.push(part.as_os_str()); }
+    if result.as_os_str().is_empty() { result.push("."); }
+    Ok(result.to_string_lossy().into_owned())
 }
 
