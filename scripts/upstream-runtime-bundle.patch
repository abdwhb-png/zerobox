+#[test]
+fn private_bind_rejects_a_redirected_canonical_ancestor() {
+    let root = tempfile::tempdir().unwrap();
+    let source = root.path().join("authorized/data");
+    let outside = root.path().join("outside");
+    std::fs::create_dir_all(&source).unwrap();
+    std::fs::create_dir_all(outside.join("data")).unwrap();
+    std::fs::rename(root.path().join("authorized"), root.path().join("previous")).unwrap();
+    std::os::unix::fs::symlink(&outside, root.path().join("authorized")).unwrap();
+    let result = prepare_private_bind_mounts(vec![PrivateBindMount {
+        source, destination: PathBuf::from("/tools"), read_only: true,
+        pre_remount: false, before_policy: false, exact_unix_socket: None, source_fd: None,
+    }]);
+    assert!(result.is_err(), "a canonical authorization must not follow a replaced ancestor");
+}
