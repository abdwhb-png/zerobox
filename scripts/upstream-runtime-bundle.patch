+#[test]
+fn private_namespaces_are_bound_before_project_mounts() {
+    let root = tempfile::tempdir().unwrap();
+    let source = root.path().join("private-tmp");
+    std::fs::create_dir(&source).unwrap();
+    let mut args = crate::bwrap::BwrapArgs {
+        args: ["bwrap", "--tmpfs", "/", "--ro-bind", "/tmp/project", "/tmp/project", "--remount-ro", "/", "--", "true"].into_iter().map(str::to_owned).collect(),
+        preserved_files: Vec::new(), synthetic_mount_targets: Vec::new(),
+        protected_create_targets: Vec::new(), used_tmpfs_root: true,
+    };
+    let mounts = prepare_private_bind_mounts(vec![PrivateBindMount {
+        source, destination: PathBuf::from("/tmp"), read_only: false,
+        pre_remount: false, before_policy: true, exact_unix_socket: None, source_fd: None,
+    }]).unwrap();
+    inject_private_bind_mounts(&mut args, mounts).unwrap();
+    let namespace = args.args.iter().position(|arg| arg == "--bind-fd").unwrap();
+    let project = args.args.iter().position(|arg| arg == "--ro-bind").unwrap();
+    assert!(namespace < project);
+    assert_eq!(args.args[namespace + 2], "/tmp");
+    assert_eq!(args.preserved_files.len(), 1);
+    assert_eq!(relative_runtime_alias_target(Path::new("/lib"), Path::new("/usr/lib")).unwrap(), "usr/lib");
+    assert_eq!(relative_runtime_alias_target(Path::new("/usr/lib64/loader"), Path::new("/usr/lib/x86/loader")).unwrap(), "../lib/x86/loader");
