+pub(crate) fn claim_transient_synthetic_mount(path: &Path) -> bool {
+    with_synthetic_mount_registry_lock(|| {
+        let marker_dir = synthetic_mount_marker_dir(path);
+        if path.exists() && !synthetic_mount_marker_dir_has_active_synthetic_owner(&marker_dir) {
+            return false;
+        }
+        fs::create_dir_all(&marker_dir).unwrap_or_else(|err| {
+            panic!("failed to create synthetic mount marker {}: {err}", marker_dir.display())
+        });
+        // Retain ownership across argv construction and later registration,
+        // under the same lock used by concurrent cleanup.
+        fs::write(marker_dir.join(std::process::id().to_string()), SYNTHETIC_MOUNT_MARKER_SYNTHETIC)
+            .unwrap_or_else(|err| panic!("failed to claim synthetic mount {}: {err}", path.display()));
+        true
+    })
+}
