+fn transient_empty_metadata_path(path: &Path) -> Option<EmptyProtectedMetadataPath> {
+    let metadata = fs::symlink_metadata(path).ok()?;
+    // Claim shared synthetic targets before their last owner can clean up.
+    // Real empty files/directories must retain their live read-only bind.
+    if !((metadata.is_file() && metadata.len() == 0)
+        || (metadata.is_dir() && directory_is_empty(path)))
+        || !crate::linux_run_main::claim_transient_synthetic_mount(path)
+    {
