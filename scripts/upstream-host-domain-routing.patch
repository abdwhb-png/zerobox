+fn parse_host_network_rules(entries: &[String]) -> anyhow::Result<Vec<NetworkRule>> {
+    entries
+        .iter()
+        .map(|entry| {
+            let rule = NetworkRule::parse(entry).map_err(|err| {
+                NetworkProxyConstraintError::InvalidValue {
+                    field_name: "network.allowed_host_domains",
+                    candidate: entry.clone(),
+                    allowed: err.to_string(),
+                }
+            })?;
+            let domain = rule
+                .pattern
+                .strip_prefix("**.")
+                .or_else(|| rule.pattern.strip_prefix("*."))
+                .unwrap_or(&rule.pattern);
+            let valid_domain = !domain.is_empty()
+                && !domain.contains('*')
+                && matches!(url::Host::parse(domain), Ok(url::Host::Domain(_)));
+            if rule.port.is_none()
+                || rule.pattern == "*"
+                || rule.is_explicit_loopback()
+                || rule.pattern.parse::<IpAddr>().is_ok()
+                || !valid_domain
+            {
+                return Err(NetworkProxyConstraintError::InvalidValue {
+                    field_name: "network.allowed_host_domains",
+                    candidate: rule.as_string(),
+                    allowed: "exact DNS hostnames or scoped wildcards with an explicit port"
+                        .to_string(),
+                }
+                .into_anyhow());
+            }
+            Ok(rule)
+        })
+        .collect()
+}
