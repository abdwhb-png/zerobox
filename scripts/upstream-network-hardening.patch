+fn parse_network_rules(
+    field_name: &'static str,
+    entries: &[String],
+) -> anyhow::Result<Vec<NetworkRule>> {
+    entries
+        .iter()
+        .map(|entry| {
+            let rule = NetworkRule::parse(entry).map_err(|err| {
+                NetworkProxyConstraintError::InvalidValue {
+                    field_name,
+                    candidate: entry.clone(),
+                    allowed: err.to_string(),
+                }
+            })?;
+            if rule.is_explicit_loopback() && rule.port.is_none() {
+                return Err(NetworkProxyConstraintError::InvalidValue {
+                    field_name,
+                    candidate: rule.as_string(),
+                    allowed: "localhost, 127.0.0.1, and [::1] require an explicit port".to_string(),
+                }
+                .into_anyhow());
+            }
+            if rule.is_private_ip_literal() && !rule.is_explicit_loopback() {
+                return Err(NetworkProxyConstraintError::InvalidValue {
+                    field_name,
+                    candidate: rule.as_string(),
+                    allowed: "private IP literals are not permitted network rules".to_string(),
+                }
+                .into_anyhow());
+            }
+            Ok(rule)
+        })
+        .collect()
+}
