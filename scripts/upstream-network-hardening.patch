+/// A domain policy rule with an optional, exact destination port.
+///
+/// The textual form is `pattern` or `pattern:port`; IPv6 literals must use
+/// brackets (`[::1]:443`) so a port can never be inferred ambiguously.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NetworkRule {
+    pub pattern: String,
+    pub port: Option<u16>,
+}
+
+impl NetworkRule {
+    pub fn parse(value: &str) -> Result<Self> {
+        let value = value.trim();
+        if value.is_empty() || value.chars().any(char::is_whitespace) {
+            bail!("network rule must be a non-empty pattern[:port]");
+        }
+
+        let (pattern, port) = if let Some(rest) = value.strip_prefix('[') {
+            let end = rest
+                .find(']')
+                .ok_or_else(|| anyhow::anyhow!("network rule has an unclosed IPv6 literal"))?;
+            let host = &rest[..end];
+            let suffix = &rest[end + 1..];
+            if host.is_empty() || !suffix.is_empty() && !suffix.starts_with(':') {
+                bail!("network rule must be pattern[:port]");
+            }
+            (host, parse_optional_rule_port(suffix)?)
+        } else {
+            let colon_count = value.bytes().filter(|byte| *byte == b':').count();
+            match colon_count {
+                0 => (value, None),
+                1 => {
+                    let Some((host, port)) = value.split_once(':') else {
+                        bail!("network rule must be pattern[:port]");
+                    };
+                    (host, Some(parse_rule_port(port)?))
+                }
+                _ => bail!("IPv6 network rules must use [address]:port syntax"),
+            }
+        };
+
+        if pattern.is_empty() {
+            bail!("network rule pattern is empty");
+        }
+        let pattern = pattern.trim_end_matches('.').to_ascii_lowercase();
+        Ok(Self { pattern, port })
+    }
+
+    pub fn as_string(&self) -> String {
+        match self.port {
+            Some(port) if self.pattern.contains(':') => format!("[{}]:{port}", self.pattern),
+            Some(port) => format!("{}:{port}", self.pattern),
+            None if self.pattern.contains(':') => format!("[{}]", self.pattern),
+            None => self.pattern.clone(),
+        }
+    }
+
+    pub fn is_explicit_loopback(&self) -> bool {
+        matches!(self.pattern.as_str(), "localhost" | "127.0.0.1" | "::1")
+    }
+
+    pub fn is_private_ip_literal(&self) -> bool {
+        match self.pattern.parse::<IpAddr>() {
+            Ok(IpAddr::V4(ip)) => ip.is_private() || ip.is_loopback(),
+            Ok(IpAddr::V6(ip)) => {
+                ip.is_unique_local() || ip.is_unicast_link_local() || ip.is_loopback()
+            }
+            Err(_) => false,
+        }
+    }
+}
+
+fn parse_optional_rule_port(value: &str) -> Result<Option<u16>> {
+    if value.is_empty() {
+        Ok(None)
+    } else {
+        Ok(Some(parse_rule_port(value.strip_prefix(':').ok_or_else(
+            || anyhow::anyhow!("invalid network rule port"),
+        )?)?))
+    }
+}
+
+fn parse_rule_port(value: &str) -> Result<u16> {
+    if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) {
+        bail!("network rule port must be a decimal u16");
+    }
+    let port: u16 = value.parse().context("invalid network rule port")?;
+    if port == 0 {
+        bail!("network rule port must be non-zero");
+    }
+    Ok(port)
+}
