+#[test]
+fn setup_handshake_confirms_exec_before_enabling_signal_forwarding() {
+    let events = std::cell::RefCell::new(Vec::new());
+    let (exec_error, ()) = confirm_exec_before_enabling_signal_forwarding(
+        || {
+            events.borrow_mut().push("exec-confirmed");
+            Ok(None)
+        },
+        || {
+            events.borrow_mut().push("signal-forwarding-enabled");
+        },
+    );
+
+    assert_eq!(exec_error.expect("exec confirmation"), None);
+    assert_eq!(
+        events.into_inner(),
+        vec!["exec-confirmed", "signal-forwarding-enabled"]
+    );
+}
