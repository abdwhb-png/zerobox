+
+fn load_target_environment() -> Option<HashMap<String, String>> {
+    let path = std::env::var_os(TARGET_ENV_FILE_ENV)?;
+    let bytes = fs::read(&path).unwrap_or_else(|error| {
+        panic!(
+            "failed to read private target environment {}: {error}",
+            Path::new(&path).display()
+        )
+    });
+    Some(serde_json::from_slice(&bytes).unwrap_or_else(|error| {
+        panic!(
+            "failed to decode private target environment {}: {error}",
+            Path::new(&path).display()
+        )
+    }))
+}
+
+fn merge_internal_target_environment(
+    target: Option<HashMap<String, String>>,
+) -> Option<HashMap<String, String>> {
+    let mut target = target?;
+    for (name, value) in std::env::vars() {
+        if name != TARGET_ENV_FILE_ENV && name != "PATH" {
+            target.insert(name, value);
+        }
+    }
+    Some(target)
 }
 
