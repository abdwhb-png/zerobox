+fn private_docker_route(env: &HashMap<String, String>) -> io::Result<Option<ProxyRouteEntry>> {
+    let Some(path) = env.get(DOCKER_BROKER_SOCKET_ENV) else {
+        return Ok(None);
+    };
+    if env.get(DOCKER_HOST_ENV).map(String::as_str) != Some("tcp://127.0.0.1:1") {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "private Docker routing requires the internal DOCKER_HOST placeholder",
+        ));
+    }
+
+    let path = PathBuf::from(path);
+    if !path.is_absolute() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "private Docker broker socket must be absolute",
+        ));
+    }
+    let metadata = std::fs::symlink_metadata(&path)?;
+    if metadata.file_type().is_symlink()
+        || !metadata.file_type().is_socket()
+        || metadata.uid() != unsafe { libc::geteuid() }
+        || metadata.permissions().mode() & 0o777 != 0o600
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "private Docker broker socket must be an owner-only Unix socket",
+        ));
+    }
+    let parent = path.parent().ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "private Docker broker socket must have a parent directory",
+        )
+    })?;
+    let parent_metadata = std::fs::symlink_metadata(parent)?;
+    if parent_metadata.file_type().is_symlink()
+        || !parent_metadata.is_dir()
+        || parent_metadata.uid() != unsafe { libc::geteuid() }
+        || parent_metadata.permissions().mode() & 0o777 != 0o700
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "private Docker broker directory must be owner-only",
+        ));
+    }
+
+    Ok(Some(ProxyRouteEntry {
+        env_key: DOCKER_HOST_ENV.to_string(),
+        uds_path: path,
+    }))
+}
