+fn proxy_bidirectional<Left, Right>(
+    mut left: Left,
+    mut right: Right,
+    mut left_reader: Left,
+    mut right_writer: Right,
+) -> io::Result<()>
+where
+    Left: Read + Write + Send + 'static,
+    Right: Read + Write + Send + 'static,
+{
+    let left_to_right =
+        std::thread::spawn(move || std::io::copy(&mut left_reader, &mut right_writer));
+    let right_to_left = std::io::copy(&mut right, &mut left);
+    let left_to_right = left_to_right
