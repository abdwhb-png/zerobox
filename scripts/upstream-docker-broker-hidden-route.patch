+fn inject_private_proxy_mount(args: &mut Vec<String>, proxy_root: &Path) -> std::io::Result<()> {
+    let metadata = fs::symlink_metadata(proxy_root)?;
+    if metadata.file_type().is_symlink() || !metadata.is_dir() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "private proxy root must be a non-symlink directory",
+        ));
+    }
+    let separator = args
+        .iter()
+        .position(|argument| argument == "--")
+        .ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "missing command separator",
+            )
+        })?;
+    args.splice(
+        separator..separator,
+        [
+            "--dir".to_string(),
+            PRIVATE_PROXY_MOUNT_ROOT.to_string(),
+            "--ro-bind".to_string(),
+            proxy_root.to_string_lossy().into_owned(),
+            PRIVATE_PROXY_MOUNT_ROOT.to_string(),
+        ],
+    );
+    Ok(())
+}
