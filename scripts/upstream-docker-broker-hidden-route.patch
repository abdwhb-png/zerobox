+fn spawn_host_broker_bridge(endpoint: &Path, uds_path: &Path) -> io::Result<libc::pid_t> {
+    let (read_fd, write_fd) = create_ready_pipe()?;
+    let pid = unsafe { libc::fork() };
+    if pid < 0 {
+        let err = io::Error::last_os_error();
+        close_fd(read_fd)?;
+        close_fd(write_fd)?;
+        return Err(err);
+    }
+
+    if pid == 0 {
+        if close_fd(read_fd).is_err() {
+            unsafe { libc::_exit(1) };
+        }
+        let result = run_host_broker_bridge(endpoint, uds_path, write_fd);
+        if result.is_err() {
+            unsafe { libc::_exit(1) };
+        }
+        unsafe { libc::_exit(0) };
+    }
+
+    close_fd(write_fd)?;
+    let mut ready = [0_u8; 1];
+    let mut read_file = unsafe { File::from_raw_fd(read_fd) };
+    read_file.read_exact(&mut ready)?;
+    if ready[0] != HOST_BRIDGE_READY {
+        return Err(io::Error::other(
+            "host Unix bridge did not acknowledge readiness",
+        ));
+    }
+    Ok(pid)
+}
+
+fn run_host_broker_bridge(
+    endpoint: &Path,
+    uds_path: &Path,
+    ready_fd: libc::c_int,
+) -> io::Result<()> {
+    harden_bridge_process()?;
+    if uds_path.exists() {
+        std::fs::remove_file(uds_path)?;
+    }
+    let listener = UnixListener::bind(uds_path)?;
+    std::fs::set_permissions(uds_path, Permissions::from_mode(0o600))?;
+
+    let mut ready_file = unsafe { File::from_raw_fd(ready_fd) };
+    ready_file.write_all(&[HOST_BRIDGE_READY])?;
+    drop(ready_file);
+
+    let (mut control, _) = listener.accept()?;
+    std::fs::remove_file(uds_path)?;
+    drop(listener);
+
+    loop {
+        let mut request = [0_u8; 1];
+        match control.read_exact(&mut request) {
+            Ok(()) => {}
+            Err(err) if err.kind() == io::ErrorKind::UnexpectedEof => return Ok(()),
+            Err(err) => return Err(err),
+        }
+        if request[0] != BROKER_OPEN_REQUEST {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "invalid private Docker broker request",
+            ));
+        }
+
+        match UnixStream::connect(endpoint) {
+            Ok(broker) => send_unix_stream(&control, &broker)?,
+            Err(_) => control.write_all(&[BROKER_OPEN_ERROR])?,
+        }
+    }
+}
+
+fn send_unix_stream(control: &UnixStream, stream: &UnixStream) -> io::Result<()> {
+    let mut status = [BROKER_OPEN_OK];
+    let mut iovec = libc::iovec {
+        iov_base: status.as_mut_ptr().cast(),
+        iov_len: status.len(),
+    };
+    let control_len = unsafe { libc::CMSG_SPACE(std::mem::size_of::<libc::c_int>() as _) } as usize;
+    let mut ancillary = vec![0_u8; control_len];
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut iovec;
+    message.msg_iovlen = 1;
+    message.msg_control = ancillary.as_mut_ptr().cast();
+    message.msg_controllen = ancillary.len();
+
+    let descriptor = stream.as_raw_fd();
+    unsafe {
+        let header = libc::CMSG_FIRSTHDR(&message);
+        if header.is_null() {
+            return Err(io::Error::other(
+                "failed to allocate broker descriptor message",
+            ));
+        }
+        (*header).cmsg_level = libc::SOL_SOCKET;
+        (*header).cmsg_type = libc::SCM_RIGHTS;
+        (*header).cmsg_len = libc::CMSG_LEN(std::mem::size_of::<libc::c_int>() as _) as usize;
+        std::ptr::write(libc::CMSG_DATA(header).cast::<libc::c_int>(), descriptor);
+
+        let written = libc::sendmsg(control.as_raw_fd(), &message, libc::MSG_NOSIGNAL);
+        if written < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if written != 1 {
+            return Err(io::Error::new(
+                io::ErrorKind::WriteZero,
+                "private Docker broker descriptor response was truncated",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn spawn_local_broker_bridge(uds_path: &Path) -> io::Result<u16> {
+    let (read_fd, write_fd) = create_ready_pipe()?;
+    let pid = unsafe { libc::fork() };
+    if pid < 0 {
+        let err = io::Error::last_os_error();
+        close_fd(read_fd)?;
+        close_fd(write_fd)?;
+        return Err(err);
+    }
+
+    if pid == 0 {
+        if close_fd(read_fd).is_err() {
+            unsafe { libc::_exit(1) };
+        }
+        let result = run_local_broker_bridge(uds_path, write_fd);
+        if result.is_err() {
+            unsafe { libc::_exit(1) };
+        }
+        unsafe { libc::_exit(0) };
+    }
+
+    close_fd(write_fd)?;
+    let mut port_bytes = [0_u8; 2];
+    let mut read_file = unsafe { File::from_raw_fd(read_fd) };
+    read_file.read_exact(&mut port_bytes)?;
+    Ok(u16::from_be_bytes(port_bytes))
+}
+
+fn run_local_broker_bridge(uds_path: &Path, ready_fd: libc::c_int) -> io::Result<()> {
+    harden_bridge_process()?;
+    let mut control = UnixStream::connect(uds_path)?;
+    let listener = bind_local_loopback_listener()?;
+    let port = listener.local_addr()?.port();
+
+    let mut ready_file = unsafe { File::from_raw_fd(ready_fd) };
+    ready_file.write_all(&port.to_be_bytes())?;
+    drop(ready_file);
+
+    loop {
+        let (tcp_stream, _) = listener.accept()?;
+        control.write_all(&[BROKER_OPEN_REQUEST])?;
+        let Some(broker) = receive_unix_stream(&control)? else {
+            continue;
+        };
+        std::thread::spawn(move || {
+            let _ = proxy_tcp_unix(tcp_stream, broker);
+        });
+    }
+}
+
+fn receive_unix_stream(control: &UnixStream) -> io::Result<Option<UnixStream>> {
+    let mut status = [0_u8; 1];
+    let mut iovec = libc::iovec {
+        iov_base: status.as_mut_ptr().cast(),
+        iov_len: status.len(),
+    };
+    let control_len = unsafe { libc::CMSG_SPACE(std::mem::size_of::<libc::c_int>() as _) } as usize;
+    let mut ancillary = vec![0_u8; control_len];
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut iovec;
+    message.msg_iovlen = 1;
+    message.msg_control = ancillary.as_mut_ptr().cast();
+    message.msg_controllen = ancillary.len();
+
+    let received =
+        unsafe { libc::recvmsg(control.as_raw_fd(), &mut message, libc::MSG_CMSG_CLOEXEC) };
+    if received < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if received == 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::UnexpectedEof,
+            "private Docker broker control channel closed",
+        ));
+    }
+    if received != 1 || message.msg_flags & (libc::MSG_CTRUNC | libc::MSG_TRUNC) != 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "invalid private Docker broker descriptor response",
+        ));
+    }
+    if status[0] == BROKER_OPEN_ERROR {
+        return Ok(None);
+    }
+    if status[0] != BROKER_OPEN_OK {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "unknown private Docker broker descriptor status",
+        ));
+    }
+
+    let descriptor = unsafe {
+        let header = libc::CMSG_FIRSTHDR(&message);
+        if header.is_null()
+            || (*header).cmsg_level != libc::SOL_SOCKET
+            || (*header).cmsg_type != libc::SCM_RIGHTS
+            || (*header).cmsg_len
+                != libc::CMSG_LEN(std::mem::size_of::<libc::c_int>() as _) as usize
+            || !libc::CMSG_NXTHDR(&message, header).is_null()
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "private Docker broker response did not contain one descriptor",
+            ));
+        }
+        std::ptr::read(libc::CMSG_DATA(header).cast::<libc::c_int>())
+    };
+    if descriptor < 0 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "private Docker broker returned an invalid descriptor",
+        ));
+    }
+
+    Ok(Some(unsafe { UnixStream::from_raw_fd(descriptor) }))
+}
