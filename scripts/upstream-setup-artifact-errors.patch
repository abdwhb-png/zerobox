+#[test]
+fn private_target_environment_read_failure_is_typed() {
+    let root = tempfile::tempdir().expect("target environment root");
+    let missing = root.path().join("missing.json");
+
+    let error = load_target_environment_from(&missing)
+        .expect_err("missing private target environment must fail");
+
+    assert_eq!(error.code(), "target_env_read");
+}
+
+#[test]
+fn private_target_environment_decode_failure_is_typed() {
+    let root = tempfile::tempdir().expect("target environment root");
+    let invalid = root.path().join("invalid.json");
+    std::fs::write(&invalid, b"not-json").expect("write invalid target environment");
+
+    let error = load_target_environment_from(&invalid)
+        .expect_err("invalid private target environment must fail");
+
+    assert_eq!(error.code(), "target_env_decode");
+}
