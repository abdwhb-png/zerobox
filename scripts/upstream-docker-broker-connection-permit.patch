+struct BridgeConnectionPermit {
+    active: Arc<AtomicUsize>,
+}
+
+impl Drop for BridgeConnectionPermit {
+    fn drop(&mut self) {
+        self.active.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+fn try_acquire_bridge_connection(
+    active: Arc<AtomicUsize>,
+    limit: usize,
+) -> Option<BridgeConnectionPermit> {
+    active
+        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |current| {
+            (current < limit).then_some(current + 1)
+        })
+        .ok()?;
+    Some(BridgeConnectionPermit { active })
+}
