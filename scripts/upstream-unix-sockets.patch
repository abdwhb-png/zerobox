 #[cfg(test)]
+mod exact_unix_socket_tests {
+    use super::*;
+    use std::os::fd::AsRawFd;
+    use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+    use std::os::unix::net::UnixListener;
+
+    #[test]
+    fn rejects_a_deleted_preopened_exact_unix_socket() {
+        let root = tempfile::tempdir().expect("exact socket root");
+        let source = root.path().join("service.sock");
+        let original = UnixListener::bind(&source).expect("bind original socket");
+        let metadata = std::fs::symlink_metadata(&source).expect("inspect original socket");
+        let source_fd = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_PATH | libc::O_NOFOLLOW)
+            .open(&source)
+            .expect("pre-open exact source");
+        let inherited_fd = unsafe { libc::dup(source_fd.as_raw_fd()) };
+        assert!(inherited_fd >= 3, "duplicate exact source descriptor");
+        drop(original);
+        std::fs::remove_file(&source).expect("remove original socket");
+        let _replacement = UnixListener::bind(&source).expect("bind replacement socket");
+        let result = prepare_private_bind_mounts(vec![PrivateBindMount {
+            source,
+            destination: PathBuf::from("/service.sock"),
+            exact_unix_socket: Some(ExactUnixSocketIdentity {
+                dev: metadata.dev(),
+                ino: metadata.ino(),
+            }),
+            source_fd: Some(inherited_fd),
+        }])
+        ;
+        let error = match result {
+            Ok(_) => panic!("replacement must not be mounted"),
+            Err(error) => error,
+        };
+        assert_eq!(error.kind(), std::io::ErrorKind::PermissionDenied);
+        assert!(error.to_string().contains("changed before sandbox setup"));
+        drop(source_fd);
+    }
+}
