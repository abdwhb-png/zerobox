+const PRIVATE_BIND_MOUNTS_ENV: &str = "ZEROBOX_PRIVATE_BIND_MOUNTS";
+
+#[derive(Debug, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PrivateBindMount {
+    source: PathBuf,
+    destination: PathBuf,
+}
+
+fn load_private_bind_mounts() -> Vec<PrivateBindMount> {
+    let Some(serialized) = std::env::var_os(PRIVATE_BIND_MOUNTS_ENV) else {
+        return Vec::new();
+    };
+    let serialized = serialized
+        .into_string()
+        .unwrap_or_else(|_| panic!("{PRIVATE_BIND_MOUNTS_ENV} must be valid UTF-8"));
+    serde_json::from_str(&serialized)
+        .unwrap_or_else(|error| panic!("invalid {PRIVATE_BIND_MOUNTS_ENV}: {error}"))
+}
+
+fn inject_private_bind_mounts(
+    args: &mut Vec<String>,
+    mounts: &[PrivateBindMount],
+) -> std::io::Result<()> {
+    if mounts.is_empty() {
+        return Ok(());
+    }
+    let separator = args
+        .iter()
+        .position(|argument| argument == "--")
+        .ok_or_else(|| std::io::Error::new(std::io::ErrorKind::InvalidInput, "missing command separator"))?;
+    let mut bind_args = Vec::with_capacity(mounts.len() * 3);
+    for mount in mounts {
+        if !mount.source.is_absolute() || !mount.destination.is_absolute() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "private bind paths must be absolute",
+            ));
+        }
+        let metadata = fs::symlink_metadata(&mount.source)?;
+        if metadata.file_type().is_symlink() || !metadata.is_dir() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "private bind source must be a non-symlink directory",
+            ));
+        }
+        bind_args.extend([
+            "--bind".to_string(),
+            mount.source.to_string_lossy().into_owned(),
+            mount.destination.to_string_lossy().into_owned(),
+        ]);
+    }
+    args.splice(separator..separator, bind_args);
+    Ok(())
+}
+
 fn exit_with_bwrap_build_error(err: crate::error::CodexErr) -> ! {
     eprintln!("error building bubblewrap command: {err}");
     std::process::exit(1);
