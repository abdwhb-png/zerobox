+#[test]
+fn private_bind_mounts_are_inserted_before_the_target_command() {
+    let root = tempfile::tempdir().expect("private bind root");
+    let source = root.path().join("view");
+    std::fs::create_dir(&source).expect("private bind source");
+    let mut args = vec![
+        "bwrap".to_string(),
+        "--new-session".to_string(),
+        "--".to_string(),
+        "/bin/true".to_string(),
+    ];
+
+    inject_private_bind_mounts(
+        &mut args,
+        &[PrivateBindMount {
+            source: source.clone(),
+            destination: PathBuf::from("/work"),
+        }],
+    )
+    .expect("inject private bind");
+
+    assert_eq!(
+        args,
+        vec![
+            "bwrap", "--new-session", "--bind", source.to_str().unwrap(), "/work", "--",
+            "/bin/true",
+        ]
+    );
+}
