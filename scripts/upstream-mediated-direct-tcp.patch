+fn send_route_request<T>(socket: libc::c_int, request: &T) -> io::Result<()> {
+    let mut kernel = unsafe { std::mem::zeroed::<libc::sockaddr_nl>() };
+    kernel.nl_family = libc::AF_NETLINK as libc::sa_family_t;
+    let sent = unsafe {
+        libc::sendto(
+            socket,
+            std::ptr::from_ref(request).cast(),
+            std::mem::size_of::<T>(),
+            0,
+            std::ptr::from_ref(&kernel).cast(),
+            std::mem::size_of::<libc::sockaddr_nl>() as libc::socklen_t,
+        )
+    };
+    if sent < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if sent as usize != std::mem::size_of::<T>() {
+        return Err(io::Error::new(
+            io::ErrorKind::WriteZero,
+            "local route netlink request was truncated",
+        ));
+    }
+
+    let mut response = [0_u8; 4096];
+    let received = loop {
+        let received =
+            unsafe { libc::recv(socket, response.as_mut_ptr().cast(), response.len(), 0) };
+        if received >= 0 {
+            break received as usize;
+        }
+        let error = io::Error::last_os_error();
+        if error.kind() != io::ErrorKind::Interrupted {
+            return Err(error);
+        }
+    };
+    let header_length = 16;
+    if received < header_length + std::mem::size_of::<i32>() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "invalid local route netlink response",
+        ));
+    }
+    let message_type = u16::from_ne_bytes([response[4], response[5]]);
+    if message_type != libc::NLMSG_ERROR as u16 {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "unexpected local route netlink response",
+        ));
+    }
+    let error = i32::from_ne_bytes(
+        response[header_length..header_length + 4]
+            .try_into()
+            .unwrap(),
+    );
+    if error == 0 || error == -libc::EEXIST {
+        Ok(())
+    } else {
+        Err(io::Error::from_raw_os_error(-error))
+    }
+}
