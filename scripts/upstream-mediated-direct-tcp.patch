--- /dev/null
+++ upstream/linux-sandbox/src/mediated_direct.rs
@@ -0,0 +1,279 @@
+use std::fs;
+use std::io;
+use std::io::Read;
+use std::net::TcpListener;
+use std::net::UdpSocket;
+use std::os::fd::AsRawFd;
+use std::os::unix::net::UnixStream;
+use std::path::Path;
+use std::time::Duration;
+
+use zerobox_protocol::mediated_direct::MEDIATED_DIRECT_ACK;
+use zerobox_protocol::mediated_direct::MediatedDirectListenerManifest;
+
+pub(crate) fn enter_setup_namespace_and_transfer_listeners(
+    ports: &[u16],
+    broker_path: &Path,
+) -> io::Result<()> {
+    let manifest = MediatedDirectListenerManifest::new(ports.to_vec())?;
+    enter_setup_namespaces()?;
+    crate::proxy_routing::ensure_loopback_interface_up()?;
+    install_local_ipv4_route()?;
+
+    let mut direct_listeners = Vec::with_capacity(manifest.ports.len());
+    for port in &manifest.ports {
+        direct_listeners.push(TcpListener::bind(("0.0.0.0", *port)).map_err(|error| {
+            io::Error::new(error.kind(), format!("bind mediated port {port}: {error}"))
+        })?);
+    }
+    let dns_udp = UdpSocket::bind(("0.0.0.0", 53))?;
+    let dns_tcp = TcpListener::bind(("0.0.0.0", 53))?;
+
+    let mut broker = UnixStream::connect(broker_path)?;
+    broker.set_read_timeout(Some(Duration::from_secs(5)))?;
+    send_listener_descriptors(&broker, &manifest, &direct_listeners, &dns_udp, &dns_tcp)?;
+    let mut ack = [0_u8; 1];
+    broker.read_exact(&mut ack)?;
+    if ack[0] != MEDIATED_DIRECT_ACK {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "mediated broker returned an invalid acknowledgement",
+        ));
+    }
+    Ok(())
+}
+
+fn send_listener_descriptors(
+    broker: &UnixStream,
+    manifest: &MediatedDirectListenerManifest,
+    direct_listeners: &[TcpListener],
+    dns_udp: &UdpSocket,
+    dns_tcp: &TcpListener,
+) -> io::Result<()> {
+    let payload = manifest.encode();
+    let mut descriptors = direct_listeners
+        .iter()
+        .map(AsRawFd::as_raw_fd)
+        .collect::<Vec<_>>();
+    descriptors.extend([dns_udp.as_raw_fd(), dns_tcp.as_raw_fd()]);
+    if descriptors.len() != manifest.descriptor_count() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "mediated listener descriptor count mismatch",
+        ));
+    }
+
+    let mut io_vector = libc::iovec {
+        iov_base: payload.as_ptr().cast_mut().cast(),
+        iov_len: payload.len(),
+    };
+    let descriptor_bytes = descriptors.len() * std::mem::size_of::<libc::c_int>();
+    let control_len = unsafe { libc::CMSG_SPACE(descriptor_bytes as libc::c_uint) } as usize;
+    let mut control = vec![0_u8; control_len];
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut io_vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    message.msg_controllen = control.len();
+
+    unsafe {
+        let header = libc::CMSG_FIRSTHDR(&message);
+        if header.is_null() {
+            return Err(io::Error::other(
+                "could not allocate mediated descriptor message",
+            ));
+        }
+        (*header).cmsg_level = libc::SOL_SOCKET;
+        (*header).cmsg_type = libc::SCM_RIGHTS;
+        (*header).cmsg_len = libc::CMSG_LEN(descriptor_bytes as libc::c_uint) as usize;
+        std::ptr::copy_nonoverlapping(
+            descriptors.as_ptr(),
+            libc::CMSG_DATA(header).cast::<libc::c_int>(),
+            descriptors.len(),
+        );
+    }
+
+    let sent = unsafe { libc::sendmsg(broker.as_raw_fd(), &message, libc::MSG_NOSIGNAL) };
+    if sent < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if sent as usize != payload.len() {
+        return Err(io::Error::new(
+            io::ErrorKind::WriteZero,
+            "mediated descriptor message was truncated",
+        ));
+    }
+    Ok(())
+}
+
+fn enter_setup_namespaces() -> io::Result<()> {
+    let outer_uid = unsafe { libc::geteuid() };
+    let outer_gid = unsafe { libc::getegid() };
+    if unsafe { libc::unshare(libc::CLONE_NEWUSER) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    match fs::write("/proc/self/setgroups", "deny\n") {
+        Ok(()) => {}
+        Err(error) if error.kind() == io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error),
+    }
+    fs::write("/proc/self/uid_map", format!("0 {outer_uid} 1\n"))?;
+    fs::write("/proc/self/gid_map", format!("0 {outer_gid} 1\n"))?;
+    if unsafe { libc::setresgid(0, 0, 0) } != 0 || unsafe { libc::setresuid(0, 0, 0) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if unsafe { libc::unshare(libc::CLONE_NEWNET) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
+
+fn install_local_ipv4_route() -> io::Result<()> {
+    #[repr(C)]
+    struct NetlinkHeader {
+        length: u32,
+        message_type: u16,
+        flags: u16,
+        sequence: u32,
+        process_id: u32,
+    }
+
+    #[repr(C)]
+    struct RouteMessage {
+        family: u8,
+        destination_prefix_length: u8,
+        source_prefix_length: u8,
+        tos: u8,
+        table: u8,
+        protocol: u8,
+        scope: u8,
+        route_type: u8,
+        flags: u32,
+    }
+
+    #[repr(C)]
+    struct RouteAttribute {
+        length: u16,
+        attribute_type: u16,
+        output_interface: u32,
+    }
+
+    #[repr(C)]
+    struct RouteRequest {
+        header: NetlinkHeader,
+        route: RouteMessage,
+        output_interface: RouteAttribute,
+    }
+
+    let interface = unsafe { libc::if_nametoindex(c"lo".as_ptr()) };
+    if interface == 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let request = RouteRequest {
+        header: NetlinkHeader {
+            length: std::mem::size_of::<RouteRequest>() as u32,
+            message_type: libc::RTM_NEWROUTE,
+            flags: (libc::NLM_F_REQUEST | libc::NLM_F_ACK | libc::NLM_F_CREATE | libc::NLM_F_EXCL)
+                as u16,
+            sequence: 1,
+            process_id: 0,
+        },
+        route: RouteMessage {
