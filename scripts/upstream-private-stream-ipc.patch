+fn private_connected_socketpair_rules() -> std::result::Result<Vec<SeccompRule>, SandboxErr> {
+    let mut denied_types = Vec::new();
+    for kind in [libc::SOCK_STREAM, libc::SOCK_SEQPACKET] {
+        for flags in [0, libc::SOCK_CLOEXEC, libc::SOCK_NONBLOCK,
+            libc::SOCK_CLOEXEC | libc::SOCK_NONBLOCK] {
+            denied_types.push(SeccompCondition::new(
+                1, SeccompCmpArgLen::Dword, SeccompCmpOp::Ne, (kind | flags) as u64,
+            )?);
+        }
+    }
+    // Connected pairs cannot choose a new peer. Datagram pairs can reconnect
+    // to named endpoints, so their existing restrictions remain separate.
+    Ok(vec![
+        SeccompRule::new(vec![SeccompCondition::new(
+            0, SeccompCmpArgLen::Dword, SeccompCmpOp::Ne, libc::AF_UNIX as u64,
+        )?])?,
+        SeccompRule::new(vec![SeccompCondition::new(
+            2, SeccompCmpArgLen::Dword, SeccompCmpOp::Ne, 0,
+        )?])?,
+        SeccompRule::new(denied_types)?,
+    ])
+}
