+    #[test]
+    fn proxy_routed_seccomp_rejects_udp_and_raw_ip_sockets(
+    ) -> Result<(), Box<dyn std::error::Error>> {
+        set_no_new_privs()?;
+        install_network_seccomp_filter_on_current_thread(NetworkSeccompMode::ProxyRouted)?;
+
+        for domain in [libc::AF_INET, libc::AF_INET6] {
+            for socket_type in [libc::SOCK_DGRAM, libc::SOCK_RAW] {
+                let fd = unsafe {
+                    libc::socket(
+                        domain,
+                        socket_type | libc::SOCK_CLOEXEC | libc::SOCK_NONBLOCK,
+                        0,
+                    )
+                };
+                assert_eq!(fd, -1);
+                assert_eq!(io::Error::last_os_error().raw_os_error(), Some(libc::EPERM));
+            }
+        }
+
+        let tcp_fd = unsafe {
+            libc::socket(
+                libc::AF_INET,
+                libc::SOCK_STREAM | libc::SOCK_CLOEXEC,
+                0,
+            )
+        };
+        assert!(tcp_fd >= 0, "TCP bridge sockets must remain available");
+        unsafe { libc::close(tcp_fd) };
+        Ok(())
+    }
+
+    #[test]
+    fn proxy_routed_seccomp_rejects_inbound_tcp_binding(
