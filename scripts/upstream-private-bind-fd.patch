+fn prepare_private_bind_mounts(
+    mounts: Vec<PrivateBindMount>,
+) -> std::io::Result<Vec<PreparedPrivateBindMount>> {
+    mounts
+        .into_iter()
+        .map(|mount| {
+            if !mount.source.is_absolute() || !mount.destination.is_absolute() {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    "private bind paths must be absolute",
+                ));
+            }
+            let source = OpenOptions::new()
+                .read(true)
+                .custom_flags(
+                    libc::O_CLOEXEC | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_PATH,
+                )
+                .open(&mount.source)
+                .map_err(|error| {
+                    std::io::Error::new(
+                        error.kind(),
+                        format!(
+                            "open private bind source {} -> {}: {error}",
+                            mount.source.display(),
+                            mount.destination.display(),
+                        ),
+                    )
+                })?;
+            Ok(PreparedPrivateBindMount {
+                source,
+                destination: mount.destination,
+            })
+        })
+        .collect()
+}
